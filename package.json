{
  "name": "optrasentiscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts runtime/*.test.mjs scripts/runtime/prepare.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/runtime/check-prepare.mjs && node scripts/check-runtime-boundary.mjs && npm run typecheck && npm test && node --check src/web/app.js && node --check scripts/check-ui.mjs && node --check scripts/runtime/start.mjs && node --check scripts/runtime/engineering-probe.mjs && node --check scripts/runtime/native-probe.mjs && node --check scripts/sdk/verify.mjs && node --check scripts/sdk/root-probe.mjs && node --check scripts/sdk/native-probe.mjs && npm run check:native && npm run check:research && npm run check:sources && npm run check:synthetic-trial && npm run check:recovery && npm run check:longstream && npm run check:host-controls && npm run check:artifact-followup && npm run check:artifact-cold && npm run check:operator-decisions && npm run check:notifications && npm run check:outcomes && npm run check:effect-assessments && npm run check:cognition-reassessment && npm run check:experiences",
    "check:ui": "node scripts/check-ui.mjs",
    "check:sdk": "node scripts/sdk/verify.mjs",
    "setup:sdk": "node scripts/runtime/prepare.mjs --install-missing",
    "start:runtime": "node scripts/runtime/start.mjs",
    "check:research": "node scripts/check-research.mjs",
    "check:sources": "node scripts/check-shared-sources.mjs",
    "check:synthetic-trial": "node scripts/check-synthetic-trial.mjs",
    "check:native": "node scripts/check-research.mjs --native",
    "check:recovery": "node scripts/check-recovery.mjs",
    "check:legacy-recovery": "SENTISCOPE_LEGACY_PROJECT=\"$PWD/.local/legacy-6ec330d\" node scripts/check-recovery.mjs",
    "check:longstream": "node scripts/check-longstream.mjs",
    "check:host-controls": "node scripts/check-host-controls.mjs",
    "check:artifact-followup": "node scripts/check-artifact-followup.mjs",
    "check:artifact-cold": "node scripts/check-artifact-cold.mjs",
    "check:operator-decisions": "node scripts/check-operator-decisions.mjs",
    "check:operator-decisions-ui": "node scripts/check-decision-ui.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "check:notifications-ui": "node scripts/check-notification-ui.mjs",
    "check:outcomes": "node scripts/check-outcomes.mjs",
    "check:outcomes-ui": "node scripts/check-outcome-ui.mjs",
    "check:effect-assessments": "node scripts/check-effect-assessments.mjs",
    "check:cognition-reassessment": "node scripts/check-cognition-reassessment.mjs",
    "check:experiences": "node scripts/check-experiences.mjs",
    "check:effect-ui": "node scripts/check-effect-ui.mjs",
    "check:general-ui": "node scripts/check-general-ui.mjs",
    "check:lifecycle-ui": "node scripts/check-lifecycle-ui.mjs",
    "check:revocation-ui": "node scripts/check-revocation-ui.mjs",
    "check:auth-ui": "node scripts/check-auth-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
